{
  "name": "openoperator-crm",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config dist/server/wrangler.json && wrangler dev --persist-to .wrangler/state --config dist/server/wrangler.json --var ALLOW_INSECURE_LOCAL_AUTH:true --var ADMIN_EMAILS:owner@example.com",
    "dev:hot": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:typecheck && npm run test:prepare && npm run test:twenty && node --test tests/rendered-html.test.mjs && node scripts/run-worker-tests.mjs && vitest run --config vitest.edge.config.ts",
    "test:typecheck": "tsc --noEmit",
    "test:prepare": "node scripts/prepare-test-build.mjs",
    "test:unit": "npm run build && npm run test:prepare && node --test tests/rendered-html.test.mjs",
    "test:worker": "npm run build && npm run test:prepare && node scripts/run-worker-tests.mjs",
    "test:ingest": "vitest run --config vitest.edge.config.ts",
    "test:twenty": "node scripts/verify-twenty-integration.mjs",
    "ingest:types": "wrangler types --config ingest-worker/wrangler.jsonc ingest-worker/env.d.ts",
    "ingest:check": "wrangler deploy --config ingest-worker/wrangler.jsonc --dry-run",
    "ingest:deploy": "wrangler deploy --config ingest-worker/wrangler.jsonc",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .test-dist --ignore-pattern .next --ignore-pattern twenty-reference --ignore-pattern worker-configuration.d.ts --ignore-pattern ingest-worker/env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.8",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "^5.20260817.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "10.8.1",
    "eslint-config-next": "^16.3.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module"
}
