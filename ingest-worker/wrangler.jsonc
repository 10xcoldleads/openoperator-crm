{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openoperator-crm-ingest",
  "main": "index.ts",
  "compatibility_date": "2026-07-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ingest.example.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "CRM_ORIGIN": "https://crm.example.com"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INGEST_RATE_GATE",
        "class_name": "IngestRateGate"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IngestRateGate"
      ]
    }
  ],
  "limits": {
    "cpu_ms": 50,
    "subrequests": 5
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
